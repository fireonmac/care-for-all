DATABASE_URL=file:./app_data/sqlite.db
# 원격 libSQL: DATABASE_URL=libsql://<database-host>, DATABASE_AUTH_TOKEN 설정
# DATABASE_AUTH_TOKEN=
# 기존 TURSO_AUTH_TOKEN도 호환 입력으로 지원. 둘 다 있으면 DATABASE_AUTH_TOKEN 우선.
# 영속 디스크 없는 호스트에서는 true. Vercel은 설정 경계에서 자동으로 강제.
# DATABASE_REQUIRE_REMOTE=true
# 모든 호스트에서 허용 계정 제한이 기본값. 비공개 로컬 개발에서만 false 선택 가능.
# AUTH_REQUIRE_ALLOWLIST=false
ALLOWED_EMAILS=caregiver@example.com

# ollama | openai-compatible
AI_PROVIDER=ollama
AI_MODEL=gemma4:26b

# 기본 URL이 아닌 엔드포인트나 OpenAI 호환 API를 사용할 때 설정
# AI_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY=
# Gemini: 기존 openai-compatible 어댑터와 인터페이스 유지
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=<사용 가능한 Gemini 모델 ID>
# AI_API_KEY=<Gemini API key>

# --- Better Auth ---
BETTER_AUTH_SECRET="your-random-secret-key"
# Vercel에서 생략하면 시스템 VERCEL_URL의 HTTPS origin을 사용
BETTER_AUTH_URL="http://localhost:3000"

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
